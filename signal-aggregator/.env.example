# Signal Aggregator configuration
# Copy to .env and adjust.

# --- Server (this service's own API + dashboard) ---
PORT=3002
DB_PATH=./data/signals.db

# --- Markets ---
# Apple Music storefront country codes (ISO 3166-1 alpha-2, lowercase).
# These are the markets collected, briefed, designed for and tested against.
# Default verified set: us,gb,fr,de,br,jp,in,ng
MARKETS=us,gb,fr,de,br,jp,in,ng

# --- Collection ---
APPLE_CHART_SIZE=50
DEEZER_CHART_SIZE=50
REQUEST_TIMEOUT_MS=20000
REQUEST_RETRIES=3

# --- Periodic collection scheduler ---
# Off by default: a CLI run must never start a background timer unasked.
# `serve --schedule` or SCHEDULE_ENABLED=true turns it on.
# Forecasting is a derivative, so history only becomes usable if this runs
# regularly (ideally daily for weeks).
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_MINUTES=360
SCHEDULE_ENRICH_TOP=20
SCHEDULE_BRIEF=true
SCHEDULE_RUN_ON_START=true

# --- Forecasting ---
FORECAST_HORIZON_DAYS=7
# Minimum projected rank gain for a track to appear on the rising board.
FORECAST_MIN_GAIN=0.5
# Depth required before a cycle will design against the forecast instead of the
# current brief: insufficient | low | moderate | high
FORECAST_MIN_DESIGN_DEPTH=moderate

# --- ACE-Step pipeline (the running ace-step-ui backend) ---
ACESTEP_UI_URL=http://localhost:3001
# Username used when this service has to bootstrap its own pipeline account.
ACESTEP_UI_USERNAME=signal-aggregator
PIPELINE_POLL_MS=5000
PIPELINE_TIMEOUT_MS=900000

# --- Song design defaults ---
CONCEPTS_PER_MARKET=3
BATCH_SIZE=1
THINKING=true
ENHANCE=true
DURATION=120
INFERENCE_STEPS=8
GUIDANCE_SCALE=7.0
AUDIO_FORMAT=mp3

# --- Scoring weights & loop thresholds ---
WEIGHT_MARKET_FIT=0.5
WEIGHT_NOVELTY=0.2
WEIGHT_HUMAN=0.3
CHAMPION_THRESHOLD=0.70
VIABLE_THRESHOLD=0.55
LEARNING_RATE=0.25

# --- Optional key-gated sources (blank = disabled, cycle continues without them) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
GEMINI_API_KEY=